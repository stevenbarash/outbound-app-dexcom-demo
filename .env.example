# Descope project (from https://app.descope.com/settings/project)
NEXT_PUBLIC_DESCOPE_PROJECT_ID=
DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=

# Outbound App id you configured in Descope Console for Dexcom
NEXT_PUBLIC_DESCOPE_OUTBOUND_APP_ID=dexcom
DESCOPE_OUTBOUND_APP_ID=dexcom

# Dexcom API base — sandbox by default; for production use https://api.dexcom.com
DEXCOM_API_BASE=https://sandbox-api.dexcom.com

# Optional: Descope base URL override
# DESCOPE_BASE_URL=https://api.descope.com
